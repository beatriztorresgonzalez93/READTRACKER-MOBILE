# Nativo: URL absoluta del API en Render.
# Web local (Expo :8081): si apunta a Render, activa CORS_ALLOW_LOCALHOST=true en Render
#   o deja vacío y levanta el API local (cd server && npm run dev → http://localhost:4000/api/v1).
# Web Vercel: deja vacío o usa /api/v1 — vercel.json reenvía /api/v1 al backend (sin CORS).
EXPO_PUBLIC_API_BASE_URL=https://readtracker-api.onrender.com/api/v1
# Firebase Auth (Configuración del proyecto > Tus apps > SDK)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# Opcional; la foto de perfil se guarda en Firestore (no hace falta Storage).
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# URL de la app web (Vercel). En iOS/Android permite abrir el checkout Pro en el navegador.
EXPO_PUBLIC_WEB_APP_ORIGIN=https://tu-app.vercel.app
# Opcional; debe coincidir con PRO_TRIAL_DAYS del backend (por defecto 30).
EXPO_PUBLIC_PRO_TRIAL_DAYS=30
# Push de re-engagement (Expo): Project ID en https://expo.dev → tu proyecto → Project settings
EXPO_PUBLIC_EAS_PROJECT_ID=

