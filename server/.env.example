PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Producción (Render): lista explícita — tu Vercel + Expo web local si lo necesitas
# CLIENT_ORIGINS=https://tu-app.vercel.app,http://localhost:8081,http://localhost:19006
# CORS_ALLOW_VERCEL_PREVIEWS=true
# CORS_ALLOW_LOCALHOST=true
# Opcional: sufijos de host HTTPS para previews Vercel (cada deploy cambia el subdominio)
# CORS_ORIGIN_SUFFIXES=-tuusuario.vercel.app,-tuusuario-projects.vercel.app
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# Firebase Admin (JSON de cuenta de servicio: Project ID, client_email, private_key)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Usa comillas y \\n para saltos de línea en la clave privada
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n....\\n-----END PRIVATE KEY-----\\n"
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CURRENCY=eur
PRO_ONE_TIME_PRICE_CENTS=1999
PRO_TRIAL_DAYS=30

# Opcional: subida de imágenes a S3 con Firebase (POST /api/v1/uploads/cover y POST /api/v1/uploads/avatar).
# Misma configuración AWS: fotos de perfil van a users/{id}/avatars/; portadas a users/{id}/covers/.
# El IAM user necesita s3:PutObject en arn:aws:s3:::BUCKET/users/*
# Para mostrar portadas en la app sin URLs firmadas por lectura, permite s3:GetObject público en ese prefijo o usa CloudFront.
# AWS_REGION=eu-west-1
# S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
#
# Opcional: enriquecer metadatos al escanear ISBN (sinopsis en español, un solo género).
# Sin ninguna clave, la app traduce en el móvil con MyMemory (gratis, sin registro).
# Groq: plan gratuito en https://console.groq.com (recomendado si quieres IA en servidor).
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
#
# Push de re-engagement (Expo Push API): avisos si el usuario lleva días sin abrir la app.
# CRON_SECRET=un-secreto-largo-aleatorio
# PUSH_ENGAGEMENT_ENABLED=true
# ENGAGEMENT_INACTIVE_DAYS=3
# ENGAGEMENT_PUSH_COOLDOWN_DAYS=7
# Programar en Render Cron (diario): npm run push:engagement (con API_BASE_URL y CRON_SECRET)
#
# Seed de biblioteca de prueba (solo desarrollo; npm run seed:books desde server/):
# SEED_USER_EMAIL=tu@correo.com
# SEED_COUNT=1000
# SEED_RESET=true
#
# Si subes portadas desde la WEB (Vercel), el bucket S3 necesita CORS que permita PUT desde ese origen:
# Consola AWS → S3 → tu bucket → Permisos → configuración de CORS → pegar JSON (ajusta AllowedOrigins):
# [
#   {
#     "AllowedHeaders": ["*"],
#     "AllowedMethods": ["GET", "PUT", "HEAD"],
#     "AllowedOrigins": ["https://readtracker-mobile.vercel.app", "http://localhost:8081", "http://localhost:19006"],
#     "ExposeHeaders": ["ETag"],
#     "MaxAgeSeconds": 3000
#   }
# ]
# En app nativa el PUT no pasa por CORS del navegador.
